# distributed-configs-fs — copy to .env and edit.
#
#   cp .env.example .env
#   docker compose up --build
#
# Every value here is also a `dcfs` flag; the flag wins if both are given.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The shared cluster secret. Possession of it IS membership — it is expanded
# into the gossip encryption key, the peer API signing key, and the key that
# seals response bodies. It must be identical on every node and at least 16
# characters; the node refuses to start otherwise.
#
# Generate one with:  openssl rand -base64 32
DCFS_CLUSTER_SECRET=change-me-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# What this node exposes locally
# ---------------------------------------------------------------------------

# Directory the replicated tree is projected onto. Empty disables mirror mode.
# In compose this is bind-mounted, so it is also what you edit on the host.
DCFS_MIRROR_DIR=/etc/cluster

# FUSE mountpoint. Empty (the default) disables mount mode.
#
# Enabling it in a container needs all three of:
#   devices:      - /dev/fuse
#   cap_add:      - SYS_ADMIN
#   security_opt: - apparmor:unconfined
# and, for the mount to be visible on the host, a bind mount with rshared
# propagation. See the commented-out block in docker-compose.yml.
DCFS_MOUNT_POINT=

# Where this node's SQLite database lives. This is the source of truth, so it
# belongs on a volume — losing it means re-fetching the whole tree from a peer.
DCFS_DB=/var/lib/dcfs/dcfs.db

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Address gossip binds to inside the container.
DCFS_BIND_ADDR=0.0.0.0
DCFS_GOSSIP_PORT=7946

# Peer HTTP API. 0.0.0.0 inside a container network; bind it to 127.0.0.1 if
# you run outside one, since it serves the contents of your config tree.
DCFS_API_ADDR=0.0.0.0:7947

# What peers should dial. These matter behind NAT and wherever the address a
# peer must use is not the address this process bound to. Inside a compose
# network the service name resolves for every other container, so
# DCFS_ADVERTISE_ADDR is set per-service in docker-compose.yml rather than here.
#DCFS_ADVERTISE_ADDR=
#DCFS_ADVERTISE_GOSSIP_PORT=
#DCFS_ADVERTISE_API=

# Seed addresses, comma-separated. Any single reachable seed is enough —
# membership propagates from there — and a node whose seeds are all down still
# starts and serves its local tree.
#DCFS_JOIN=node1:7946,node2:7946

# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------

# Largest file this node will replicate, in bytes. A config tree is not a file
# share; without a cap, one large file dropped into the mirror directory
# replicates into every node's database. Default 1 MiB.
DCFS_MAX_FILE_SIZE=1048576

# How long deletions are remembered.
#
# READ THIS ONE. A deletion is replicated as a tombstone, and a node that was
# offline during the deletion learns about it by comparing against that
# tombstone when it returns. Once the tombstone is collected, a node returning
# after that still has the file, sees nothing saying it was deleted, and
# re-announces it — undoing the deletion across the whole cluster.
#
# So this must exceed the longest outage any node may have. Seven days is a
# reasonable default; raise it if a node might be off for longer.
DCFS_TOMBSTONE_TTL=168h

# How often to reconcile with peers regardless of gossip. Gossip hints only make
# convergence faster; this interval is what makes it correct.
DCFS_SYNC_INTERVAL=30s

# How often to rescan the mirror directory. This is the backstop for dropped
# inotify events — and on Docker Desktop for macOS or Windows, where inotify
# does not propagate through a host bind mount at all, it is the ONLY thing that
# notices host-side edits. Lower it if you develop on Docker Desktop.
DCFS_SCAN_INTERVAL=60s

# How often expired tombstones and unreferenced content are collected.
DCFS_JANITOR_INTERVAL=1h

# How long to wait after the last change to a file before reading it. Editors
# save in several syscalls, so reading immediately can capture a half-written
# file.
DCFS_SETTLE=300ms

# debug, info, warn, error
DCFS_LOG_LEVEL=info
